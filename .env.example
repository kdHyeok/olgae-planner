# docker compose 가 읽는 환경변수. 이 파일을 .env 로 복사해 값을 채운다.
# POSTGRES_PASSWORD 는 필수 (없으면 compose 가 기동을 거부한다).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# /mcp 의 Host 검사. 배포 도메인을 넣는다. 빈 값이면 검사를 끈다(권장하지 않음).
MCP_ALLOWED_HOSTS=prd.donyk.link,localhost:3000,127.0.0.1:3000

# MCP OAuth 메타데이터와 세션 쿠키 보안 설정에 쓰는 외부 주소.
# Google callback도 이 origin에서 파생한다. 로컬 Google 로그인 시 http://localhost:3000으로 변경한다.
PUBLIC_URL=https://prd.donyk.link

# Google Cloud의 "웹 애플리케이션" OAuth 클라이언트 값. 실제 값은 .env에만 둔다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
