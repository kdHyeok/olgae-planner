# docker compose 가 읽는 환경변수. 이 파일을 .env 로 복사해 값을 채운다.
# POSTGRES_PASSWORD 는 필수 (없으면 compose 가 기동을 거부한다).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# /mcp 의 Host 검사. 배포 도메인을 넣는다. 빈 값이면 검사를 끈다(권장하지 않음).
MCP_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# OAuth 메타데이터에 표시할 외부 주소. 로컬 OAuth 테스트는 http://localhost:3000 으로 바꾼다.
PUBLIC_URL=https://prd.donhse.duckdns.org
